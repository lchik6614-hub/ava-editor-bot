NODE_ENV=production
PORT=3000

# Public HTTPS address of this Pterodactyl server.
# The Telegram Mini App should use: https://YOUR_DOMAIN/mini-app/
PUBLIC_BASE_URL=https://api.example.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=avaeditorbot

PAYMENT_PROVIDER=cryptobot
PRICE_USD=0.65

CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_BASE_URL=https://pay.crypt.bot/api
CRYPTOBOT_ASSET=USDT
CRYPTOBOT_INVOICE_EXPIRES_IN=3600

GENERATOR_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-fill-pro
REPLICATE_POLL_INTERVAL_MS=1500
REPLICATE_TIMEOUT_MS=180000

TEXT_MASK_X=95
TEXT_MASK_Y=825
TEXT_MASK_WIDTH=835
TEXT_MASK_HEIGHT=175
TEXT_X=95
TEXT_Y=825
TEXT_WIDTH=835
TEXT_HEIGHT=175
TEXT_FONT_SIZE=112
TEXT_FONT_FAMILY=Arial
TEXT_FILL=#f4f7fb
TEXT_STROKE=#273247
TEXT_STROKE_WIDTH=5

# Leave empty when Mini App is served from this same server.
CORS_ORIGINS=
MAX_UPLOAD_BYTES=10485760
STORAGE_DIR=./storage
DATABASE_PATH=./storage/orders.sqlite