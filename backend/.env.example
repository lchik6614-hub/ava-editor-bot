NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://api.example.com

# Никогда не коммитьте реальные значения в GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=avaeditorbot

# cryptobot | xrocket
PAYMENT_PROVIDER=cryptobot
PRICE_USD=0.65

# Crypto Pay API
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_BASE_URL=https://pay.crypt.bot/api
CRYPTOBOT_ASSET=USDT
CRYPTOBOT_INVOICE_EXPIRES_IN=3600

# Xrocket включается только при PAYMENT_PROVIDER=xrocket.
# Endpoint и формат ответа нужно сверить с вашим кабинетом Xrocket.
XROCKET_API_TOKEN=
XROCKET_API_BASE_URL=
XROCKET_CREATE_INVOICE_PATH=/invoices
XROCKET_WEBHOOK_SECRET=

# Внешняя inpainting-модель. Финальный ник добавляется Sharp после inpainting,
# чтобы текст был точным, а не сгенерированным с ошибками.
GENERATOR_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-fill-pro
REPLICATE_POLL_INTERVAL_MS=1500
REPLICATE_TIMEOUT_MS=180000

# Область старого текста на шаблоне 1024x1024.
TEXT_MASK_X=95
TEXT_MASK_Y=825
TEXT_MASK_WIDTH=835
TEXT_MASK_HEIGHT=175

# Координаты точного финального текста.
TEXT_X=95
TEXT_Y=825
TEXT_WIDTH=835
TEXT_HEIGHT=175
TEXT_FONT_SIZE=112
TEXT_FONT_FAMILY=Arial
TEXT_FILL=#f4f7fb
TEXT_STROKE=#273247
TEXT_STROKE_WIDTH=5

CORS_ORIGINS=https://lchik6614-hub.github.io
MAX_UPLOAD_BYTES=10485760
STORAGE_DIR=./storage
DATABASE_PATH=./storage/orders.sqlite